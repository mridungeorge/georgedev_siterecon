# SQLite file for rate-limit counters and stored reports.
SITERECON_DB=./data/siterecon.db
# Rate limits (defaults shown).
RL_PER_IP_HOUR=5
RL_PER_IP_DAY=10
RL_GLOBAL_DAY=50
RL_PER_TARGET_HOUR=3
# Set to "true" only when the edge proxy (Caddy on the VM) sets its own
# X-Forwarded-For. Left unset, every visitor shares one rate-limit bucket.
TRUST_PROXY=false

# Free-tier AI (the content review and marketing ideas). Both are optional: with neither set,
# those parts are reported as "couldn't check". Use a key from a project with billing OFF.
NVIDIA_NIM_API_KEY=
GEMINI_API_KEY=
# NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
# GEMINI_MODEL=gemini-2.5-flash-lite
# Which provider to try first: nim (default) or gemini.
LLM_PRIMARY=nim
# Free Google PageSpeed Insights key (performance and Core Web Vitals). Optional.
PAGESPEED_API_KEY=
# Daily guards, set below each provider's free limit.
QUOTA_LLM_DAY=400
QUOTA_PAGESPEED_DAY=200
